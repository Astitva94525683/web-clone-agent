# Copy this file to .env and put your key in LLM_API_KEY.

# --- LLM: any OpenAI-compatible API. Default: Google Gemini (free tier) ---
# Get a key at https://aistudio.google.com -> Get API key -> Create API key
LLM_API_KEY=your-gemini-api-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-latest
# Cheaper/faster model for analysis, planning and repairs (defaults to LLM_MODEL)
# LLM_MODEL_FAST=gemini-flash-latest
# Send a screenshot to the model during analysis (retries text-only if a model rejects images)
LLM_VISION=true
LLM_MAX_CONCURRENCY=4
# Seconds to wait for the next streamed chunk before giving up
# LLM_TIMEOUT=180

# Prices in USD per 1M tokens, used for the cost report (0 on the free tier)
LLM_PRICE_INPUT=0
LLM_PRICE_INPUT_CACHED=0
LLM_PRICE_OUTPUT=0

# Other providers work too (check model ids with `python cli.py models <filter>`):
# DeepSeek:   LLM_BASE_URL=https://api.deepseek.com            LLM_MODEL=deepseek-flash
#             LLM_PRICE_INPUT=0.30 LLM_PRICE_INPUT_CACHED=0.006 LLM_PRICE_OUTPUT=1.20
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1          LLM_MODEL=<provider/model>
# NVIDIA:     LLM_BASE_URL=https://integrate.api.nvidia.com/v1   LLM_MODEL=<id>  LLM_VISION=false

# --- Pipeline ---
# fast = measured components, the AI fixes only the weakest parts; full = the AI rewrites every part
GENERATION_MODE=fast
REFINE_ENABLED=true
REFINE_BELOW=88
REFINE_MAX_SECTIONS=3
# Parts whose measured code is bigger than this are never sent for an AI rewrite (too slow)
REFINE_MAX_CHARS=15000
MAX_REPAIR_ATTEMPTS=3
# Time limits in seconds, so a slow AI endpoint can never stall the agent:
# the AI-fix step of a clone, one chat edit, one AI call, and the page analysis
AI_TIME_BUDGET=300
MODIFY_TIME_BUDGET=600
LLM_MAX_CALL_SECONDS=300
ANALYZE_MAX_SECONDS=150
# LLM_PROVIDER=mock   # force offline mode (no API calls)
