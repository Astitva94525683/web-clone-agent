# --- LLM (any OpenAI-compatible API). Default: DeepSeek V4 ---
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Cheaper/faster model for analysis, planning and repairs (defaults to LLM_MODEL)
# LLM_MODEL_FAST=deepseek-flash
# DeepSeek V4 "thinks" by default; disabled = faster + cheaper code generation
LLM_THINKING=disabled
# Send a screenshot to the model during analysis (deepseek-flash is multimodal;
# the agent retries text-only automatically if a model rejects images)
LLM_VISION=true
LLM_MAX_CONCURRENCY=4

# Prices in USD per 1M tokens, used for the cost report
LLM_PRICE_INPUT=0.30
LLM_PRICE_INPUT_CACHED=0.006
LLM_PRICE_OUTPUT=1.20

# Example: NVIDIA API catalog (build.nvidia.com) - check ids with `python cli.py models deepseek`
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=deepseek-ai/deepseek-v4-pro
# LLM_VISION=false
# LLM_MAX_CONCURRENCY=2

# Example: OpenRouter instead of DeepSeek direct
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4-flash

# --- Pipeline budgets ---
MAX_REPAIR_ATTEMPTS=3
REFINE_ENABLED=true
REFINE_MAX_SECTIONS=3
# LLM_PROVIDER=mock   # force offline mode (no API calls)
